rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    
    // Catch-all Default Deny Net
    match /{document=**} {
      allow read, write: if false;
    }

    // --- Global Helpers ---
    function isSignedIn() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    function getDocUserId(data) {
      return ('userId' in data) ? data.userId : (('user_id' in data) ? data.user_id : '');
    }

    function incoming() {
      return request.resource.data;
    }

    function existing() {
      return resource.data;
    }

    // --- Rules for collections ---

    // Connection testing doc
    match /test/{docId} {
      allow read, write: if true;
    }

    // Users collection
    match /users/{userId} {
      allow read, write: if true;
    }

    // Pages collection
    match /pages/{pageId} {
      allow read, write: if true;
    }

    // Tables collection
    match /tables/{tableId} {
      allow read, write: if true;
    }

    // Records collection
    match /records/{recordId} {
      allow read, write: if true;
    }

    // User settings collection
    match /user_settings/{settingId} {
      allow read, write: if true;
    }

    // Files / Media uploads collection
    match /files/{fileId} {
      allow read, write: if true;
    }

    // Site Users (registered end users of built websites)
    match /site_users/{siteUserId} {
      allow read, write: if true;
    }
  }
}
